    "lib/**/*"
  ],
  "bugs": {
    "url": "https://github.com/appit-online/insta-api-wrapper/issues"
  },
  "homepage": "https://github.com/appit-online/insta-api-wrapper#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.7",
    "@types/node-forge": "^1.3.13",
    "@types/node-localstorage": "^1.3.3",
    "jest": "^30.0.3",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.0",
"typescript": "~5.5.4"
  },
  "dependencies": {
    "big-integer": "^1.6.52",
    "got": "^14.4.7",
    "node-forge": "^1.3.1",
    "node-localstorage": "^3.0.5",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  }
